{
  "name": "vscode-magic-pdf",
  "displayName": "Magic PDF",
  "description": "%extension.description%",
  "version": "1.2.0",
  "publisher": "ELS4NTA",
  "license": "Apache-2.0",
  "author": {
    "name": "Daniel Santanilla",
    "url": "https://github.com/ELS4NTA"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Visualization",
    "Machine Learning"
  ],
  "keywords": [
    "pdf",
    "pdf editor",
    "pdf viewer",
    "pdf preview",
    "pdf annotation",
    "document",
    "editor",
    "annotate",
    "dark mode",
    "translate",
    "viewer",
    "visualization"
  ],
  "icon": "media/vscode-magic-pdf.png",
  "galleryBanner": {
    "color": "#16213E",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/github/actions/workflow/status/ELS4NTA/vscode-magic-pdf/ci.yml?branch=main&label=CI",
      "href": "https://github.com/ELS4NTA/vscode-magic-pdf/actions/workflows/ci.yml",
      "description": "CI build status"
    },
    {
      "url": "https://img.shields.io/github/license/ELS4NTA/vscode-magic-pdf",
      "href": "https://github.com/ELS4NTA/vscode-magic-pdf/blob/main/LICENSE",
      "description": "License"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ELS4NTA/vscode-magic-pdf"
  },
  "bugs": {
    "url": "https://github.com/ELS4NTA/vscode-magic-pdf/issues"
  },
  "homepage": "https://github.com/ELS4NTA/vscode-magic-pdf#readme",
  "qna": "marketplace",
  "packageManager": "npm@11.15.0",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "capabilities": {
      "untrustedWorkspaces": {
        "supported": true
      },
      "virtualWorkspaces": {
        "supported": false,
        "description": "%capabilities.virtualWorkspaces.description%"
      }
    },
    "customEditors": [
      {
        "viewType": "magicPdf.preview",
        "displayName": "Magic PDF",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "magicPdf.goToOutlineEntry",
        "title": "%command.goToOutlineEntry.title%",
        "category": "Magic PDF"
      },
      {
        "command": "magicPdf.goToPage",
        "title": "%command.goToPage.title%",
        "category": "Magic PDF"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "magicPdf.goToOutlineEntry",
          "when": "false"
        },
        {
          "command": "magicPdf.goToPage",
          "when": "magicPdf.hasActivePdf"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "magicPdf.outline",
          "name": "%view.outline.name%",
          "when": "magicPdf.hasActivePdf",
          "icon": "$(file-pdf)"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Magic PDF",
      "properties": {
        "magicPdf.theme": {
          "markdownDescription": "%config.theme.description%",
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "%config.theme.auto%",
            "%config.theme.light%",
            "%config.theme.dark%"
          ],
          "scope": "resource",
          "order": 1
        },
        "magicPdf.toolbarDensity": {
          "markdownDescription": "%config.toolbarDensity.description%",
          "type": "string",
          "default": "normal",
          "enum": [
            "normal",
            "compact",
            "touch"
          ],
          "enumDescriptions": [
            "%config.toolbarDensity.normal%",
            "%config.toolbarDensity.compact%",
            "%config.toolbarDensity.touch%"
          ],
          "order": 2
        },
        "magicPdf.default.cursor": {
          "markdownDescription": "%config.default.cursor.description%",
          "type": "string",
          "default": "select",
          "enum": [
            "select",
            "hand"
          ],
          "enumDescriptions": [
            "%config.default.cursor.select%",
            "%config.default.cursor.hand%"
          ],
          "scope": "resource",
          "order": 10
        },
        "magicPdf.default.scale": {
          "markdownDescription": "%config.default.scale.description%",
          "type": "string",
          "default": "auto",
          "pattern": "^(\\d+(?:\\.\\d+)?|auto|page-actual|page-fit|page-width)$",
          "scope": "resource",
          "order": 11
        },
        "magicPdf.default.sidebar": {
          "markdownDescription": "%config.default.sidebar.description%",
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "pages",
            "outline",
            "attachments",
            "layers"
          ],
          "enumDescriptions": [
            "%config.default.sidebar.none%",
            "%config.default.sidebar.pages%",
            "%config.default.sidebar.outline%",
            "%config.default.sidebar.attachments%",
            "%config.default.sidebar.layers%"
          ],
          "scope": "resource",
          "order": 12
        },
        "magicPdf.default.scrollMode": {
          "markdownDescription": "%config.default.scrollMode.description%",
          "type": "string",
          "default": "vertical",
          "enum": [
            "vertical",
            "horizontal",
            "wrapped",
            "page"
          ],
          "enumDescriptions": [
            "%config.default.scrollMode.vertical%",
            "%config.default.scrollMode.horizontal%",
            "%config.default.scrollMode.wrapped%",
            "%config.default.scrollMode.page%"
          ],
          "scope": "resource",
          "order": 13
        },
        "magicPdf.default.spreadMode": {
          "markdownDescription": "%config.default.spreadMode.description%",
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "odd",
            "even"
          ],
          "enumDescriptions": [
            "%config.default.spreadMode.none%",
            "%config.default.spreadMode.odd%",
            "%config.default.spreadMode.even%"
          ],
          "scope": "resource",
          "order": 14
        },
        "magicPdf.default.textLayer": {
          "markdownDescription": "%config.default.textLayer.description%",
          "type": "string",
          "default": "enable",
          "enum": [
            "enable",
            "disable",
            "enablePermissions"
          ],
          "enumDescriptions": [
            "%config.default.textLayer.enable%",
            "%config.default.textLayer.disable%",
            "%config.default.textLayer.enablePermissions%"
          ],
          "scope": "resource",
          "order": 15
        },
        "magicPdf.default.annotations": {
          "markdownDescription": "%config.default.annotations.description%",
          "type": "string",
          "default": "enableForms",
          "enum": [
            "disable",
            "enable",
            "enableForms",
            "enableStorage"
          ],
          "enumDescriptions": [
            "%config.default.annotations.disable%",
            "%config.default.annotations.enable%",
            "%config.default.annotations.enableForms%",
            "%config.default.annotations.enableStorage%"
          ],
          "scope": "resource",
          "order": 16
        },
        "magicPdf.default.annotationEditor": {
          "markdownDescription": "%config.default.annotationEditor.description%",
          "type": "string",
          "default": "none",
          "enum": [
            "disable",
            "none",
            "freeText",
            "highlight",
            "ink",
            "stamp",
            "signature",
            "comment"
          ],
          "enumDescriptions": [
            "%config.default.annotationEditor.disable%",
            "%config.default.annotationEditor.none%",
            "%config.default.annotationEditor.freeText%",
            "%config.default.annotationEditor.highlight%",
            "%config.default.annotationEditor.ink%",
            "%config.default.annotationEditor.stamp%",
            "%config.default.annotationEditor.signature%",
            "%config.default.annotationEditor.comment%"
          ],
          "scope": "resource",
          "order": 17
        },
        "magicPdf.default.externalLinkTarget": {
          "markdownDescription": "%config.default.externalLinkTarget.description%",
          "type": "string",
          "default": "blank",
          "enum": [
            "none",
            "self",
            "blank",
            "parent",
            "top"
          ],
          "enumDescriptions": [
            "%config.default.externalLinkTarget.none%",
            "%config.default.externalLinkTarget.self%",
            "%config.default.externalLinkTarget.blank%",
            "%config.default.externalLinkTarget.parent%",
            "%config.default.externalLinkTarget.top%"
          ],
          "scope": "resource",
          "order": 18
        },
        "magicPdf.enableScripting": {
          "markdownDescription": "%config.enableScripting.description%",
          "type": "boolean",
          "default": false,
          "scope": "machine-overridable",
          "order": 30
        },
        "magicPdf.enablePermissions": {
          "markdownDescription": "%config.enablePermissions.description%",
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "order": 31
        },
        "magicPdf.enableHWA": {
          "markdownDescription": "%config.enableHWA.description%",
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "order": 40
        },
        "magicPdf.maxCanvasPixels": {
          "markdownDescription": "%config.maxCanvasPixels.description%",
          "type": "number",
          "default": 33554432,
          "minimum": -1,
          "scope": "machine",
          "order": 41
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "check-types": "tsc -p tsconfig.host.json && tsc -p tsconfig.webview.json",
    "compile": "npm run check-types && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --preserveWatchOutput",
    "package": "npm run check-types && node esbuild.js --production",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "vsce:package": "vsce package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.91.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "extensionKind": [
    "ui"
  ]
}
